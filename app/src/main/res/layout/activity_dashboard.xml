<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Dashboard">


    <RelativeLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@drawable/bg_gradient_pink"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="70dp">
        <ImageView
            android:id="@+id/profileImage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/bg_circle_white"
            android:src="@drawable/bg_circle_white"
            android:scaleType="centerCrop"
            android:contentDescription="Profile photo" />
        <ImageView
            android:id="@+id/notificationBell"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/bg_circle_white_translucent"
            android:padding="8dp"
            android:contentDescription="Notifications" />
        <TextView
            android:id="@+id/userName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/profileImage"
            android:layout_toStartOf="@id/notificationBell"
            android:layout_alignTop="@id/profileImage"
            android:layout_marginStart="12dp"
            android:text="Lordan Canchico"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/userLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/userName"
            android:layout_toEndOf="@id/profileImage"
            android:layout_toStartOf="@id/notificationBell"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:text="Ecoland, Davao City"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

    </RelativeLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/searchCard"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/headerSection"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="-54dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
    <EditText
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="What are you looking for..."
        android:textSize="13sp"
        android:background="@null"
        android:singleLine="true"
        android:inputType="text"
        android:autofillHints="" />
    </LinearLayout>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center_vertical">
    <ImageView
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_weight="1"
        android:contentDescription="Home" />
    <ImageView
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_weight="1"
        android:contentDescription="Favorites" />

    <ImageView
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_weight="1"
        android:contentDescription="Cart" />

    <ImageView
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_weight="1"
        android:contentDescription="Profile" />
    </LinearLayout>
    <ScrollView
        android:id="@+id/dashboardScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/searchCard"
        android:layout_above="@id/bottomNav"
        android:clipToPadding="false"
        android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Exclusive Offers"
        android:textColor="#C2185B"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="10dp" />
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#F48FB1">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Exclusive offer banner" />
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
    <View
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/dot_active" />
    <View
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/dot_inactive" />

    <View
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/dot_inactive" />

    <View
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/dot_inactive" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="14dp">
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Currently Trending"
        android:textColor="#C2185B"
        android:textStyle="bold"
        android:textSize="16sp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="See All"
        android:textColor="#C2185B"
        android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">
        <include layout="@layout/item_product_trending" />
        <include layout="@layout/item_product_trending" />
        <include layout="@layout/item_product_trending" />

    </LinearLayout>

    </LinearLayout>
    </ScrollView>
</RelativeLayout>