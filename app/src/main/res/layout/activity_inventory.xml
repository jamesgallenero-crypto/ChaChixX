<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".Inventory">

    <!-- Header: back button + brand title -->
    <RelativeLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@drawable/bg_gradient_pink"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/bg_circle_white"
            android:padding="12dp"
            android:src="@drawable/back"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/brandTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_alignTop="@id/back"
            android:gravity="center"
            android:text="ChaChix Scents"
            android:textColor="#FFFFFF"
            android:textStyle="bold|italic"
            android:textSize="20sp"
            android:fontFamily="cursive" />

    </RelativeLayout>

    <TextView
        android:id="@+id/inventoryHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerSection"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:text="Inventory"
        android:textColor="#880E4F"
        android:textStyle="bold"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/inventorySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/inventoryHeading"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:text="View and manage your product stocks."
        android:textColor="#9E9E9E"
        android:textSize="12sp" />

    <!-- Search bar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/searchCard"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/inventorySubtitle"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/search"
                android:contentDescription="Search" />

            <EditText
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Search product..."
                android:textColorHint="#E91E63"
                android:textColor="#333333"
                android:textSize="13sp"
                android:background="@null"
                android:singleLine="true"
                android:inputType="text"
                android:autofillHints="" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Filter chips -->
    <HorizontalScrollView
        android:id="@+id/filterScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/searchCard"
        android:layout_marginTop="16dp"
        android:paddingStart="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filterAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_chip_selected"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="All"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterPerfume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_chip_unselected"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Perfume"
                android:textColor="#E91E63"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterBodyMist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_chip_unselected"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Body Mist"
                android:textColor="#E91E63"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterLotion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_chip_unselected"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Lotion"
                android:textColor="#E91E63"
                android:textSize="12sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom nav -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:src="@drawable/home"
            android:contentDescription="Home" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:src="@drawable/water"
            android:contentDescription="Favorites" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:src="@drawable/cart"
            android:contentDescription="Cart" />

        <ImageView
            android:id="@+id/profile"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:src="@drawable/profile"
            android:contentDescription="Profile" />

    </LinearLayout>

    <!-- Product list -->
    <ScrollView
        android:id="@+id/inventoryScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/filterScroll"
        android:layout_above="@id/bottomNav"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Product: Richy -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/richyImage"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_circle_pink_light"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/product2"
                        android:contentDescription="Richy" />

                    <ImageView
                        android:id="@+id/richyMenu"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:src="@drawable/menu"
                        android:contentDescription="More options" />

                    <TextView
                        android:id="@+id/richyName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/richyImage"
                        android:layout_alignTop="@id/richyImage"
                        android:layout_marginStart="14dp"
                        android:text="RICHY"
                        android:textColor="#C2185B"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/richyCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/richyName"
                        android:layout_toEndOf="@id/richyImage"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="2dp"
                        android:text="Perfume"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/richyStock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/richyCategory"
                        android:layout_toEndOf="@id/richyImage"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="2dp"
                        android:text="Stock: 10"
                        android:textColor="#E91E63"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignBaseline="@id/richyStock"
                        android:background="@drawable/bg_badge_in_stock"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="In Stock"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="10sp" />

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Product: Scentricity -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/scentricityImage"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_circle_pink_light"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/product1"
                        android:contentDescription="Scentricity" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:src="@drawable/menu"
                        android:contentDescription="More options" />

                    <TextView
                        android:id="@+id/scentricityName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/scentricityImage"
                        android:layout_alignTop="@id/scentricityImage"
                        android:layout_marginStart="14dp"
                        android:text="SCENTRICITY"
                        android:textColor="#C2185B"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/scentricityCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/scentricityName"
                        android:layout_toEndOf="@id/scentricityImage"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="2dp"
                        android:text="Perfume"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/scentricityStock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/scentricityCategory"
                        android:layout_toEndOf="@id/scentricityImage"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="2dp"
                        android:text="Stock: 20"
                        android:textColor="#E91E63"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignBaseline="@id/scentricityStock"
                        android:background="@drawable/bg_badge_in_stock"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="In Stock"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="10sp" />

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Product: Luminous -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/luminousImage"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_circle_pink_light"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/product3"
                        android:contentDescription="Luminous" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:src="@drawable/menu"
                        android:contentDescription="More options" />

                    <TextView
                        android:id="@+id/luminousName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/luminousImage"
                        android:layout_alignTop="@id/luminousImage"
                        android:layout_marginStart="14dp"
                        android:text="LUMINOUS"
                        android:textColor="#C2185B"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/luminousCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/luminousName"
                        android:layout_toEndOf="@id/luminousImage"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="2dp"
                        android:text="Perfume"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/luminousStock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/luminousCategory"
                        android:layout_toEndOf="@id/luminousImage"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="2dp"
                        android:text="Stock: 15"
                        android:textColor="#E91E63"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignBaseline="@id/luminousStock"
                        android:background="@drawable/bg_badge_in_stock"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="In Stock"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="10sp" />

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Product: Kelsey -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/kelseyImage"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_circle_pink_light"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/product4"
                        android:contentDescription="Kelsey" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:src="@drawable/menu"
                        android:contentDescription="More options" />

                    <TextView
                        android:id="@+id/kelseyName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/kelseyImage"
                        android:layout_alignTop="@id/kelseyImage"
                        android:layout_marginStart="14dp"
                        android:text="KELSEY"
                        android:textColor="#C2185B"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/kelseyCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/kelseyName"
                        android:layout_toEndOf="@id/kelseyImage"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="2dp"
                        android:text="Perfume"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/kelseyStock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/kelseyCategory"
                        android:layout_toEndOf="@id/kelseyImage"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="2dp"
                        android:text="Stock: 25"
                        android:textColor="#E91E63"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignBaseline="@id/kelseyStock"
                        android:background="@drawable/bg_badge_in_stock"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="In Stock"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="10sp" />

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Product: Candice -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/candiceImage"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_circle_pink_light"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/product5"
                        android:contentDescription="Candice" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:src="@drawable/menu"
                        android:contentDescription="More options" />

                    <TextView
                        android:id="@+id/candiceName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/candiceImage"
                        android:layout_alignTop="@id/candiceImage"
                        android:layout_marginStart="14dp"
                        android:text="CANDICE"
                        android:textColor="#C2185B"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/candiceCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/candiceName"
                        android:layout_toEndOf="@id/candiceImage"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="2dp"
                        android:text="Perfume"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/candiceStock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/candiceCategory"
                        android:layout_toEndOf="@id/candiceImage"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="2dp"
                        android:text="Stock: 30"
                        android:textColor="#E91E63"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignBaseline="@id/candiceStock"
                        android:background="@drawable/bg_badge_in_stock"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="In Stock"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="10sp" />

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>